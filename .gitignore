# Secretos: nunca a git. La lista de variables, sin valores, va en .env.example
.env
.env.*
!.env.example

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Dependencias y builds
node_modules/
__pycache__/
.venv/
dist/
build/

# Historial y archivos internos que HyperFrames deja en la carpeta de cada episodio al renderizar
.hyperframes/

# Hojas de personaje y documentos del creador: pesan decenas de MB y llevan su rostro; nunca a git.
docs/documentos/

# Vistas sueltas de los escenarios (25 MB cada una); en git van solo las hojas de vistas
biblioteca/escenarios/*/vistas/

# Piezas de trabajo de los personajes (llevan el rostro del creador)
biblioteca/personajes/_trabajo/
biblioteca/personajes/tutor/
biblioteca/personajes/hoja_prueba_salon.png
*.blend1
